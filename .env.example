# Required backend configuration
DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=change-me-locally

# Browser and callback origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# Real job providers (configure at least one)
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Optional read-only GitHub App and official GitHub MCP connection
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
